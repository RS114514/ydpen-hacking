            "charLightColor" => 0xff265283,   // キャラ補正光合成色
            "charLightType" => ltPsSoftLight, // キャラ補正光合成種別
            "charBrightness" => -32,          // キャラ明度補正
            "charContrast" => -38,            // キャラコントラスト補正
			],

