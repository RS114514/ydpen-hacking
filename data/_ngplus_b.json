{
  "ch20": [
    {"speaker": "", "text": "二周目·平屋。"},
    {"speaker": "", "text": "窗棂内侧刻着一九二二，刀口朝里。"},
    {"speaker": "池雨曦", "text": "刻的人没打算给人看。"},
    {"speaker": "我", "text": "现在被看见了。"},
    {"speaker": "", "text": "晚晴山房的桌面上，一圈茶渍圈住一个只剩半边的字。"},
    {"speaker": "池雨曦", "text": "晴。上半截被擦掉了。"},
    {"speaker": "我", "text": "擦得很稳，不像失手。"},
    {"speaker": "", "text": "冬至那天，光只扫过碑上第三行，两分钟就移走。"},
    {"speaker": "池雨曦", "text": "所以没人拍到过第三行。"},
    {"speaker": "我", "text": "今年拍到了。"},
    {"speaker": "", "text": "光移走后，刻痕退回影子里，碑面又平了。"},
    {"speaker": "池雨曦", "text": "一年只亮两分钟。够了。"}
  ],
  "ch28": [
    {"speaker": "", "text": "二周目·天台。"},
    {"speaker": "", "text": "风向标卡在东南，风向袋却朝西北，一直没修。"},
    {"speaker": "池雨曦", "text": "卡了多久，没人说得清。"},
    {"speaker": "我", "text": "拍进去像穿帮。"},
    {"speaker": "池雨曦", "text": "留着。它自己会说。"},
    {"speaker": "", "text": "机房线槽里塞着张旧纸条，写着一个时长：五分十二秒。"},
    {"speaker": "池雨曦", "text": "第一版的时长。谁塞的？"},
    {"speaker": "我", "text": "下面用铅笔改过，五分零九。"},
    {"speaker": "", "text": "分镜墙右上角空着一格，从三月空到现在。"},
    {"speaker": "池雨曦", "text": "那一格，我没打算填。"},
    {"speaker": "我", "text": "留着做什么？"},
    {"speaker": "池雨曦", "text": "不做什么。总有人会替我们填上。"}
  ]
}
