# Zig owns the glibc sysroot. YDPEN_SYSROOT is only the device graphics/audio SDK.
# tools/build_native.py supplies these environment variables and compiler wrappers.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
foreach(name DEPS_PREFIX SYSROOT TOOL_BIN TARGET)
    if(NOT DEFINED YDPEN_${name})
        set(YDPEN_${name} "$ENV{YDPEN_${name}}" CACHE STRING "Ydpen ${name}")
    endif()
    if("${YDPEN_${name}}" STREQUAL "")
        message(FATAL_ERROR "YDPEN_${name} must be set; use tools/build_native.py")
    endif()
endforeach()
if(NOT YDPEN_TARGET MATCHES "^aarch64-linux-gnu\\.2\\.(1[7-9]|2[0-9])$")
    message(FATAL_ERROR "Only aarch64 Linux glibc 2.17 through 2.29 is supported")
endif()
set(CMAKE_C_COMPILER "${YDPEN_TOOL_BIN}/ydpen-cc")
set(CMAKE_CXX_COMPILER "${YDPEN_TOOL_BIN}/ydpen-c++")
set(CMAKE_AR "${YDPEN_TOOL_BIN}/ydpen-ar" CACHE FILEPATH "Target archiver")
set(CMAKE_RANLIB "${YDPEN_TOOL_BIN}/ydpen-ranlib" CACHE FILEPATH "Target ranlib")
set(CMAKE_C_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_CXX_COMPILER_AR "${CMAKE_AR}")
set(CMAKE_C_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_CXX_COMPILER_RANLIB "${CMAKE_RANLIB}")
set(CMAKE_FIND_ROOT_PATH "${YDPEN_DEPS_PREFIX};${YDPEN_SYSROOT}")
set(CMAKE_PREFIX_PATH "${YDPEN_DEPS_PREFIX};${YDPEN_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(CMAKE_C_FLAGS_INIT "-isystem ${YDPEN_SYSROOT}/include")
set(CMAKE_CXX_FLAGS_INIT "-isystem ${YDPEN_SYSROOT}/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-L${YDPEN_SYSROOT}/lib -Wl,-rpath-link,${YDPEN_SYSROOT}/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L${YDPEN_SYSROOT}/lib -Wl,-rpath-link,${YDPEN_SYSROOT}/lib")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
# Do not set CMAKE_SYSROOT: that would override Zig's baseline glibc headers.
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${YDPEN_DEPS_PREFIX}/lib/pkgconfig:${YDPEN_SYSROOT}/lib/pkgconfig")
unset(ENV{PKG_CONFIG_SYSROOT_DIR})
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES YDPEN_DEPS_PREFIX YDPEN_SYSROOT YDPEN_TOOL_BIN YDPEN_TARGET)
